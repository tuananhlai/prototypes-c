class Tetromino {
  field int x;
  field int y;
  field int size;

  constructor Tetromino new(int ax, int ay, int asize) {
    let x = ax;
    let y = ay;
    let size = asize;
    return this;
  }

  function void drawSquare(int x, int y, int size) {
    do Screen.setColor(true);
    do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
    do Screen.setColor(false);
    do Screen.drawLine(x, y, x + size - 1, y);
    do Screen.drawLine(x, y, x, y + size - 1);
    do Screen.drawLine(x + size - 1, y, x + size - 1, y + size - 1);
    do Screen.drawLine(x, y + size - 1, x + size - 1, y + size - 1);
    return;
  }

  method void render() {
    do Tetromino.drawSquare(x, y, size);
    do Tetromino.drawSquare(x, y + size, size);
    do Tetromino.drawSquare(x + size, y + size, size);
    do Tetromino.drawSquare(x + (size * 2), y + size, size);

    return;
  }
}